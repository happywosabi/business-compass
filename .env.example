# 环境变量模板。复制为 .env 后填写：cp .env.example .env
# .env 包含密钥，不要提交到 git（已在 .gitignore 中排除）

# ===== 运行环境 =====
# development / production
APP_ENV=development
# 邮件里链接的网址前缀；服务器上改为 https://你的域名
APP_BASE_URL=http://localhost:8080
# 应用HTTP仅发布到127.0.0.1；生产必须由HTTPS代理转发至该端口
HTTP_PORT=8080
# 生产覆盖配置需要实际域名（开发留空）；见docs/部署与验收.md
APP_DOMAIN=
# 本机开发时额外加载 compose.dev.yaml（把数据库端口映射到本机，供测试使用）。服务器上删除这一行
COMPOSE_FILE=compose.yaml:compose.dev.yaml

# ===== 数据库 =====
POSTGRES_USER=business_compass
# 请改为随机密码，例如：python3 -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_PASSWORD=change-me
POSTGRES_DB=business_compass

# ===== 登录 =====
# 本机用 http 访问时设为 false；服务器启用 HTTPS 后必须为 true
SESSION_COOKIE_SECURE=false

# ===== 邮件（阿里云邮件推送）=====
# smtp：真实发送；console：只打印到 api 容器日志，不真正发送
MAIL_BACKEND=smtp
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=business@mail.smbuy.top
SMTP_PASSWORD=
MAIL_FROM=business@mail.smbuy.top
MAIL_FROM_NAME=商业罗盘

# ===== 大模型（AI 访谈阶段使用）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 以 /models 实际可用的模型为准
INTERVIEW_MODEL=deepseek-flash
REPORT_MODEL=deepseek-v4-pro
AI_DAILY_QUOTA=50
AI_TIMEOUT_SECONDS=60
AI_RUN_SECONDS=240
AI_MAX_OUTPUT_TOKENS=3000
AI_REPORT_MAX_TOKENS=8000
# 测算在独立进程运行，最多同时2个，每账号同时1个；超时进程会被终止
CALCULATION_SECONDS=5
CALCULATION_PER_MINUTE=30
CALCULATION_PER_DAY=300
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# ===== 热点与在线资讯 =====
# 固定中新网/食品伙伴网 HTTPS RSS，筛选近7天行业报道；无需额外搜索密钥
CONTENT_NEWS_ENABLED=true
# 可选叠加自部署 DailyHotApi，例如 http://dailyhot:6688（空值时仅用默认资讯）
HOTAPI_BASE_URL=
HOTAPI_CHANNELS=weibo,zhihu
WORKER_INTERVAL_SECONDS=7200
# 热点只由后台采集；公共预算，失败/空结果也计次，24小时滚动上限
HOT_DAILY_LIMIT=24
HOT_MIN_INTERVAL_SECONDS=3600
HOT_RUN_SECONDS=90

# 账号资源预算（字节含完整模型消息及工具；重试也计费）
AI_INPUT_MAX_BYTES=131072
AI_INPUT_DAILY_BYTES=8388608
PROFILE_WRITES_PER_MINUTE=30
PROFILE_WRITES_PER_DAY=300
